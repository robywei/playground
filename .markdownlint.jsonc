// markdownlint 規則設定
//
// 此檔案同時被 markdownlint-cli、markdownlint-cli2 與 VS Code 的
// markdownlint 擴充套件讀取，因此編輯器即時提示與 CI 檢查結果一致。
//
// 原則：只在有明確技術理由時偏離預設值，並在此記錄理由。
{
  "default": true,

  // MD013 行長度：停用。
  //
  // 本專案文件以繁體中文撰寫，硬斷行有三個具體問題：
  //   1. 中文沒有詞界，斷行會落在任意字元之間，可讀性反而變差。
  //   2. 硬斷行破壞 git diff —— 段落開頭插入一個詞會使整段重排，
  //      讓 review 無法分辨真正的修改。
  //   3. 中文為全角字元，80 字元約等於 160 顯示欄寬，此限制對中文
  //      並不對應任何實際的視覺寬度。
  //
  // 改採軟換行：一個段落一行，由編輯器負責視覺折行。
  "MD013": false,

  // 以下為明確固定的風格，避免同一 repo 內出現多種寫法。
  // 值皆與 markdownlint 預設一致，此處寫出僅為讓意圖可見。

  // 無序清單一律使用 "-"
  "MD004": { "style": "dash" },

  // 有序清單使用遞增數字 1. 2. 3.
  "MD029": { "style": "ordered" },

  // 程式碼圍欄一律使用反引號
  "MD048": { "style": "backtick" },

  // 斜體使用 *text*，粗體使用 **text**
  "MD049": { "style": "asterisk" },
  "MD050": { "style": "asterisk" },

  // 水平分隔線一律使用 ---
  "MD035": { "style": "---" }
}

// markdownlint-cli2 設定 —— 由 repo-template 管理（基礎層）：要改請改範本、發版後 copier update
//
// - 一條規則都沒有停用：全部 default: true，另把幾條「同檔內一致即可」的規則收斂成單一具體風格
//   （判準是「同 repo 不要有多種寫法」，而不是「現在長怎樣」）
// - 刻意不設 globs / ignores：檢查範圍由 scripts/lint/lint.sh 用 git ls-files 決定，
//   才不會掃到 temp/ 等被 gitignore 的草稿；lint.sh 要自己給檔案清單，並把「沒檢查到任何檔案」當失敗
// - 一律走 ./scripts/lint/lint.sh，不要裸跑 markdownlint（另一支 cli v1 不讀本檔）
// - 長行用 scripts/lint/md-wrap.py 折（它讀本檔的 MD013 上限）
{
  "config": {
    "default": true,
    "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
    "MD010": { "ignore_code_languages": ["go"] },  // Go 程式碼區塊豁免硬 tab：gofmt 強制 tab，改成空格會讓範例無法直接複製
    "MD060": { "style": "compact" },
    "MD004": { "style": "dash" },
    "MD029": { "style": "ordered" },
    "MD003": { "style": "atx" },       // 標題用 # ##（不用 setext 底線式）
    "MD035": { "style": "---" },       // 水平線用 ---
    "MD046": { "style": "fenced" },    // 程式碼區塊用圍欄（不用四格縮排式）
    "MD055": { "style": "leading_and_trailing" },  // 表格每列前後都要有 |
    "MD048": { "style": "backtick" },  // 程式碼圍欄用反引號
    "MD049": { "style": "asterisk" },  // 斜體用 *text*
    "MD050": { "style": "asterisk" }   // 粗體用 **text**
  }
}
